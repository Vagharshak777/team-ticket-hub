# Local Docker smoke run. Use a published digest for managed deployments.
APP_IMAGE=ticket-dashboard:local
APP_PORT=3001
APP_VOLUME=ticket-poc-app-data
POC_NETWORK=ticket-poc-net
DOCKER_DATA_ROOT=/var/lib/docker
COOKIE_SECURE=false
TRUST_PROXY=false
# Public setup sets these to true and supplies a hostname, e.g. an IP.sslip.io name.
# PUBLIC_HOST=203-0-113-10.sslip.io

# Linux scripts also accept these as exported environment variables.
# STATE_DIR=/var/lib/ticket-poc
# BACKUP_DIR=/var/backups/ticket-poc
# MIN_FREE_KB=1048576
