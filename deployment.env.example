# Copy to deployment.env and fill this in when the hosting account is ready.
# This is a setup worksheet, not application .env or a file automatically read by CI.
# Never add passwords, API tokens, private keys, or recovery codes here.

# Non-secret Hetzner account and project details.
HETZNER_ACCOUNT_EMAIL=
HETZNER_PROJECT=ticket-dashboard
HETZNER_LOCATION=hel1
HETZNER_SERVER_TYPE=cx23
SERVER_OS=ubuntu-24.04
MAX_MONTHLY_EUR=10

# Fill in after creating the VPS with a primary IPv4 address.
SERVER_IP=
SSH_USER=root
SSH_KEY_PATH=~/.ssh/team-ticket-hub-deploy
# Allow SSH only from your current administrator IP, e.g. 198.51.100.10/32.
ADMIN_IP_CIDR=

# Leave empty until SERVER_IP is known, then use IP-WITH-DASHES.sslip.io,
# or supply a domain you own pointing to that IP.
PUBLIC_HOST=

# Application source and the fixed installation directory used by systemd.
GITHUB_REPOSITORY=Vagharshak777/team-ticket-hub
SERVER_CHECKOUT=/opt/ticket-poc
